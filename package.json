{
  "name": "cadence-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "check": "npm run test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:mongo": "node --test tests/integration/mongo.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "A streaming AI chat workspace with server-enforced tone and MongoDB history.",
  "dependencies": {
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.47.0",
    "mongodb": "^7.6.0",
    "openai": "^7.18.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2",
    "vite": "^8.3.0"
  }
}
